rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /downloads/{id} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in [
          'alkaptin7878@mail.ru',
          'alkaptin@mail.ru'
        ];
    }
  }
}
